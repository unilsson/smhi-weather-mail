SMHI_LAT={{ smhi_weather_mail_lat }}
SMHI_LON={{ smhi_weather_mail_lon }}
LOCATION_NAME={{ smhi_weather_mail_location_name | to_json(ensure_ascii=False) }}
TIMEZONE={{ smhi_weather_mail_timezone | default('Europe/Stockholm') }}

SMTP_HOST={{ smhi_weather_mail_smtp_host }}
SMTP_PORT={{ smhi_weather_mail_smtp_port | default(587) }}
SMTP_SECURITY={{ smhi_weather_mail_smtp_security | default('starttls') }}
SMTP_USER={{ smhi_weather_mail_smtp_user | default('') }}
SMTP_PASSWORD={{ smhi_weather_mail_smtp_password | to_json(ensure_ascii=False) }}
SMTP_TIMEOUT={{ smhi_weather_mail_smtp_timeout | default(20) }}

MAIL_FROM={{ smhi_weather_mail_mail_from }}
MAIL_TO={{ smhi_weather_mail_mail_to | to_json(ensure_ascii=False) }}

LOG_LEVEL={{ smhi_weather_mail_log_level | default('INFO') }}
