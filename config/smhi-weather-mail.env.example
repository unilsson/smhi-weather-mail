# Position för platsen som prognosen ska avse.
SMHI_LAT=59.000000
SMHI_LON=18.000000
LOCATION_NAME=Hemma
TIMEZONE=Europe/Stockholm

# SMTP. MAIL_TO kan innehålla flera kommaseparerade adresser.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=weather@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_TIMEOUT=20

MAIL_FROM=weather@example.com
MAIL_TO=ulf@example.com,pappa@example.com

LOG_LEVEL=INFO
